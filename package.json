{
  "name": "thesfm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev",
    "build": "node scripts/clean-next-build.mjs && next build",
    "start": "next start",
    "check:i18n": "node scripts/check-translations.mjs",
    "check:maintainability": "node scripts/check-source-complexity.mjs",
    "check:repo-hygiene": "node scripts/check-repository-hygiene.mjs",
    "check:visual-system": "node scripts/check-visual-system.mjs",
    "check:prod-endpoints": "node scripts/check-production-endpoints.mjs",
    "check:public-env": "node scripts/check-public-env.mjs",
    "check:page-routes": "node scripts/check-page-route-ownership.mjs",
    "check:api-policy": "node scripts/check-api-route-policy.mjs && node scripts/check-page-route-ownership.mjs",
    "check:schema-drift-parser": "node scripts/check-supabase-migration-drift.mjs --self-test",
    "check:launch": "pnpm exec tsc --noEmit --pretty false && pnpm lint && pnpm check:i18n && pnpm check:maintainability && pnpm check:repo-hygiene && pnpm check:visual-system && pnpm check:prod-endpoints && pnpm check:public-env && pnpm check:api-policy && pnpm test:run && pnpm build && pnpm check:performance-budget",
    "check:performance-budget": "node scripts/check-performance-budget.mjs",
    "lint": "node scripts/check-eslint.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "symbols:sync": "node scripts/sync-market-symbols.mjs",
    "symbols:sync:kw": "node scripts/sync-market-symbols.mjs --only=boursa-kuwait",
    "symbols:sync:global": "node --experimental-strip-types scripts/sync-global-market-directory.mjs",
    "symbols:sync:crypto": "node scripts/sync-crypto-symbols.mjs",
    "symbols:validate": "node scripts/validate-market-symbols.mjs",
    "test": "vitest",
    "test:run": "vitest run && node --test tests/engine/*.test.mjs",
    "test:smoke": "playwright test",
    "test:performance": "playwright test --config=playwright.performance.config.ts",
    "test:coverage": "vitest run --coverage && node --test tests/engine/*.test.mjs",
    "test:ui": "vitest --ui",
    "preview": "next start",
    "preview:test": "next start",
    "qa:visual": "node scripts/qa-full-capture.mjs",
    "routes:inventory": "node scripts/release/generate-route-inventory.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-aspect-ratio": "1.1.15",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-menubar": "1.1.24",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.88.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "3.6.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "^0.454.0",
    "next": "15.5.24",
    "next-themes": "^0.4.4",
    "pdf-parse": "2.4.5",
    "pptxgenjs": "^4.0.1",
    "react": "19.3.0",
    "react-day-picker": "8.10.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.54.1",
    "react-resizable-panels": "^4.12.4",
    "recharts": "2.15.0",
    "saxes": "6.0.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.6.0",
    "vaul": "1.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yahoo-finance2": "^3.15.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/eslint-plugin-next": "15.5.24",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "eslint-plugin-react-hooks": "5.2.0",
    "sharp": "^0.35.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.0.0"
  }
}
