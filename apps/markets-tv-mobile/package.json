{
  "name": "sfm-tv-mobile",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "export:ios": "expo export --platform ios --output-dir .expo-validation/ios",
    "testflight": "eas build --platform ios --profile testflight --auto-submit"
  },
  "dependencies": {
    "expo": "57.0.33",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "6.0.3"
  }
}
