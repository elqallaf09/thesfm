{
  "cli": { "appVersionSource": "local" },
  "build": {
    "development": {
      "distribution": "internal",
      "env": { "EXPO_TV": "1" },
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_TV": "1" },
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "production": {
      "env": { "EXPO_TV": "1" },
      "android": { "buildType": "app-bundle" },
      "ios": { "simulator": false }
    }
  }
}
