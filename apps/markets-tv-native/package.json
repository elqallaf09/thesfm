{
  "name": "sfm-markets-tv-native",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "config:tv": "expo config --type prebuild",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "prebuild:tvos": "expo prebuild --platform ios --no-install",
    "android": "expo run:android",
    "tvos": "expo run:ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:tvos": "expo export --platform ios --output-dir dist/tvos"
  },
  "dependencies": {
    "expo": "57.0.27",
    "expo-font": "57.0.4",
    "react": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86.3-0"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "0.1.7",
    "@types/react": "19.2.2",
    "typescript": "6.0.3"
  },
  "expo": { "install": { "exclude": ["react-native"] } }
}
