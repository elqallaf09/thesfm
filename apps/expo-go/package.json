{
  "name": "the-sfm-expo-go",
  "version": "0.2.1",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:finance": "cross-env SFM_PRODUCT=finance expo start",
    "start:investor": "cross-env SFM_PRODUCT=investor expo start",
    "start:business": "cross-env SFM_PRODUCT=business expo start",
    "start:finance:tunnel": "cross-env SFM_PRODUCT=finance expo start --tunnel",
    "start:investor:tunnel": "cross-env SFM_PRODUCT=investor expo start --tunnel",
    "start:business:tunnel": "cross-env SFM_PRODUCT=business expo start --tunnel",
    "doctor": "pnpm dlx expo-doctor",
    "check:expo-updates": "expo install --check",
    "validate": "tsc --noEmit && pnpm install --frozen-lockfile && expo export --platform android --output-dir .expo-validation/validate --clear"
  },
  "dependencies": {
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-device": "57.0.2",
    "expo-document-picker": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-image-picker": "57.0.20",
    "expo-notifications": "57.0.9",
    "expo-print": "57.0.2",
    "expo-screen-capture": "57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "57.0.23",
    "expo-status-bar": "~57.0.1",
    "fflate": "0.8.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "typescript": "~6.0.3"
  }
}
