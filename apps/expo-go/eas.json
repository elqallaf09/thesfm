      }
    },
    "business-huawei": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "SFM_PRODUCT": "business",
        "SFM_DISTRIBUTION": "huawei"
      }
    }
  },
  "submit": {
    "finance-production": {
      "ios": {
        "ascAppId": "6820083151"
      }
    },
    "investor-production": {
      "ios": {
        "ascAppId": "6820084328"
