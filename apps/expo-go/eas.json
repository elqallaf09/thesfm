{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "finance-preview": {
      "distribution": "internal",
      "env": {
        "SFM_PRODUCT": "finance"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "investor-preview": {
      "distribution": "internal",
      "env": {
        "SFM_PRODUCT": "investor"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "business-preview": {
      "distribution": "internal",
      "env": {
        "SFM_PRODUCT": "business"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "finance-production": {
      "autoIncrement": true,
      "env": {
        "SFM_PRODUCT": "finance"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "investor-production": {
      "autoIncrement": true,
      "env": {
        "SFM_PRODUCT": "investor"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "business-production": {
      "autoIncrement": true,
      "env": {
        "SFM_PRODUCT": "business"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "finance-huawei": {
