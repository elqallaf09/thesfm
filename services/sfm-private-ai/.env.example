# SFM Private AI model service
# Copy to .env on the GPU host. Never commit real keys.

# Text/reasoning baseline.
# Qwen3-32B-AWQ is the recommended single-GPU production starting point for a
# 48 GB-class NVIDIA GPU. It keeps the 32B model quality while using 4-bit AWQ.
SFM_MODEL=Qwen/Qwen3-32B-AWQ
SFM_SERVED_MODEL=sfm-primary
SFM_AI_API_KEY=replace-with-a-long-random-secret
# Start with 16K context for safer KV-cache headroom; raise only after load tests.
SFM_MAX_MODEL_LEN=16384
# SFM_GPU_COUNT also controls vLLM tensor-parallel size.
SFM_GPU_COUNT=1
SFM_GPU_MEMORY_UTILIZATION=0.90
# Qwen3 reasoning stays private; vLLM separates it from the final answer.
SFM_REASONING_PARSER=qwen3
SFM_BIND_PORT=8000

# Optional vision model for receipts/documents. Start with:
# docker compose --profile vision up -d
# Choose a vLLM-compatible vision-language model that fits its assigned GPU(s).
SFM_VISION_MODEL=
SFM_VISION_SERVED_MODEL=sfm-vision
SFM_VISION_API_KEY=replace-with-another-long-random-secret
SFM_VISION_MAX_MODEL_LEN=16384
SFM_VISION_GPU_COUNT=1
SFM_VISION_GPU_MEMORY_UTILIZATION=0.90
SFM_VISION_BIND_PORT=8001

# Keep inference runtime reproducible. Upgrade this deliberately after regression
# and security testing; do not use the mutable :latest tag in production.
SFM_VLLM_IMAGE=vllm/vllm-openai:v0.29.0

# Optional for gated Hugging Face weights. Keep empty for public models.
HUGGING_FACE_HUB_TOKEN=
